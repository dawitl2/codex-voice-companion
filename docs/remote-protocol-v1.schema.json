{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-voice:remote:1",
  "title": "Codex Voice remote monitoring envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "id", "timestamp", "payload"],
  "properties": {
    "version": {"const": 1}, "type": {"type": "string"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 128},
    "timestamp": {"type": "string", "format": "date-time"}, "payload": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"type": {"const": "client.hello"}, "payload": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}}},
    {"properties": {"type": {"const": "server.hello"}, "payload": {"type": "object", "additionalProperties": false, "required": ["bridgeName"], "properties": {"bridgeName": {"$ref": "#/$defs/name"}}}}},
    {"properties": {"type": {"const": "pair.request"}, "payload": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "pattern": "^[A-F0-9]{16}$"}}}}},
    {"properties": {"type": {"const": "auth.request"}, "payload": {"type": "object", "additionalProperties": false, "required": ["deviceId", "token"], "properties": {"deviceId": {"$ref": "#/$defs/deviceId"}, "token": {"$ref": "#/$defs/token"}}}}},
    {"properties": {"type": {"const": "pair.success"}, "payload": {"type": "object", "additionalProperties": false, "required": ["deviceId", "token", "bridgeName"], "properties": {"deviceId": {"$ref": "#/$defs/deviceId"}, "token": {"$ref": "#/$defs/token"}, "bridgeName": {"$ref": "#/$defs/name"}}}}},
    {"properties": {"type": {"const": "auth.success"}, "payload": {"type": "object", "additionalProperties": false, "required": ["deviceId", "bridgeName"], "properties": {"deviceId": {"$ref": "#/$defs/deviceId"}, "bridgeName": {"$ref": "#/$defs/name"}}}}},
    {"properties": {"type": {"enum": ["state.snapshot.request", "thread.list.request", "task.history.request", "connection.status.request", "heartbeat", "disconnect"]}, "payload": {"type": "object", "maxProperties": 0}}},
    {"properties": {"type": {"enum": ["state.snapshot", "thread.list.response", "task.history.response", "connection.status", "turn.progress", "turn.completed", "turn.failed", "turn.interrupted", "approval.pending"]}, "payload": {"$ref": "#/$defs/snapshot"}}},
    {"properties": {"type": {"enum": ["protocol.error", "request.error", "auth.failed", "pair.failed"]}, "payload": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 64}}}}}
  ],
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "optionalId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "deviceId": {"type": "string", "pattern": "^[a-f0-9-]{36}$"},
    "token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "date": {"type": "string", "format": "date-time"},
    "thread": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "project", "status"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/name"}, "project": {"$ref": "#/$defs/name"}, "status": {"enum": ["ready", "unavailable"]}}
    },
    "turn": {
      "type": "object", "additionalProperties": false, "required": ["id", "threadId", "status", "startedAt", "finishedAt"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "threadId": {"$ref": "#/$defs/id"}, "status": {"enum": ["starting", "running", "awaitingApproval", "completed", "failed", "interrupted", "unknown"]}, "startedAt": {"$ref": "#/$defs/date"}, "finishedAt": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}}
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "timestamp", "summary", "threadId", "turnId"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["bridge.connected", "bridge.disconnected", "thread.created", "thread.resumed", "turn.started", "turn.progress", "turn.completed", "turn.failed", "turn.interrupted", "approval.requested", "approval.resolved", "codex.error"]}, "timestamp": {"$ref": "#/$defs/date"}, "summary": {"type": "string", "minLength": 1, "maxLength": 240}, "threadId": {"$ref": "#/$defs/optionalId"}, "turnId": {"$ref": "#/$defs/optionalId"}}
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["epoch", "sequence", "bridgeName", "available", "mode", "selectedThreadId", "threads", "turns", "history", "historyComplete", "syncedAt"],
      "properties": {
        "epoch": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "bridgeName": {"$ref": "#/$defs/name"}, "available": {"type": "boolean"}, "mode": {"enum": ["mock", "real"]},
        "selectedThreadId": {"$ref": "#/$defs/optionalId"}, "threads": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/thread"}},
        "turns": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/turn"}}, "history": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/event"}},
        "historyComplete": {"type": "boolean"}, "syncedAt": {"$ref": "#/$defs/date"}
      }
    }
  }
}
