# Documentation only: the bridge does not auto-load .env files.
# Optional absolute native .exe path; no .cmd wrappers or shell commands.
CODEX_VOICE_CODEX_PATH=
# Optional Node 24 executable for scripts/run.ps1.
CODEX_VOICE_NODE_PATH=
# Required only with --remote. Use the actual Tailscale DNS name, never a token URL.
# Shape: wss://<actual-pc>.<actual-tailnet>.ts.net/remote
CODEX_VOICE_REMOTE_URL=
# Loopback listener only; match the private Serve backend port.
CODEX_VOICE_REMOTE_PORT=8787
# No OpenAI API keys, access tokens, or custom model provider settings are accepted.
