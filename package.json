{
  "name": "codex-voice-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows controller for companion-managed Codex app-server threads",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=30000 dist/tests/*.test.js",
    "start": "node dist/src/index.js",
    "test:real": "npm run build && node dist/scripts/real-test.js",
    "check:connection": "npm run build && node dist/scripts/connection-check.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "smol-toml": "1.9.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "typescript": "7.0.2"
  }
}
